---
interface Props {
	name: string;
	slug: string;
	description: string;
	duration: string;
	src: string;
	alt: string;
	badge?: string;
	whatsappMessage: string;
}

const { name, slug, description, duration, src, alt, badge, whatsappMessage } = Astro.props;
const whatsappHref = `https://wa.me/919995794058?text=${encodeURIComponent(whatsappMessage)}`;
---

<article
	class="bg-surface-container-lowest rounded-xl overflow-hidden shadow-[0px_4px_20px_rgba(27,20,100,0.08)] hover:-translate-y-1 hover:shadow-lg transition-all group flex flex-col h-full border border-surface-container-low"
>
	<div class="relative h-44 sm:h-48 overflow-hidden bg-surface-container-high">
		<img
			src={src}
			alt={alt}
			class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
			loading="lazy"
		/>
		{
			badge && (
				<div class="absolute top-3 right-3 bg-tertiary-container text-on-tertiary-container px-3 py-1 rounded-full text-xs font-semibold shadow-sm">
					{badge}
				</div>
			)
		}
	</div>
	<div class="p-4 md:p-6 flex flex-col flex-grow">
		<h3 class="text-lg md:text-xl font-semibold text-on-surface mb-2" style="font-family: 'Plus Jakarta Sans', sans-serif;">
			{name}
		</h3>
		<p class="text-sm md:text-base text-on-surface-variant mb-3 flex-grow">{description}</p>
		<div class="flex items-center gap-1 text-on-surface-variant mb-4">
			<span class="material-symbols-outlined text-[16px]">schedule</span>
			<span class="text-sm font-semibold">{duration}</span>
		</div>
		<div class="mt-auto grid grid-cols-1 min-[380px]:grid-cols-2 gap-2">
			<a
				href={`/destinations/${slug}`}
				class="border-2 border-primary text-primary hover:bg-primary hover:text-on-primary px-3 py-2.5 rounded-full text-sm font-semibold transition-colors flex items-center justify-center gap-1 min-w-0"
			>
				<span class="material-symbols-outlined text-[18px] shrink-0">visibility</span>
				View
			</a>
			<a
				href={whatsappHref}
				target="_blank"
				rel="noopener noreferrer"
				class="bg-primary hover:bg-primary-container text-on-primary px-3 py-2.5 rounded-full text-sm font-semibold transition-colors flex items-center justify-center gap-1 min-w-0"
			>
				<svg class="w-[18px] h-[18px] shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
					<path
						d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L0 24l6.335-1.662c1.72.937 3.659 1.432 5.631 1.433h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
					></path>
				</svg>
				Pricing
			</a>
		</div>
	</div>
</article>
