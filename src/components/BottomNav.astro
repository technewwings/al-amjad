---
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';

const navLinks = [
	{ href: '/', label: 'Home', icon: 'home' },
	{ href: '/destinations', label: 'Destination', icon: 'explore' },
	{ href: '/about', label: 'About', icon: 'info' },
	{ href: '/contact', label: 'Contact', icon: 'call' },
].map((link) => ({
	...link,
	active: link.href === '/' ? pathname === '/' : pathname.startsWith(link.href),
}));
---

<nav
	class="lg:hidden fixed bottom-0 inset-x-0 z-50 flex justify-around items-center bg-white border-t border-[#eee] pt-2 pb-[max(0.5rem,env(safe-area-inset-bottom))]"
	aria-label="Mobile primary"
>
	{
		navLinks.map((link) => (
			<a
				href={link.href}
				class="flex flex-1 flex-col items-center justify-center gap-1 no-underline min-w-0"
				aria-current={link.active ? 'page' : undefined}
			>
				<span
					class:list={[
						'flex items-center justify-center w-8 h-8',
						link.active && 'bg-secondary text-white',
					]}
					style={
						link.active
							? 'clip-path: polygon(25% 6%, 75% 6%, 100% 50%, 75% 94%, 25% 94%, 0% 50%);'
							: undefined
					}
				>
					<span
						class:list={[
							'material-symbols-outlined text-[24px]',
							link.active ? 'filled text-white' : 'text-[#9ca3af]',
						]}
					>
						{link.icon}
					</span>
				</span>
				<span
					class:list={[
						'text-[11px] leading-none',
						link.active ? 'text-secondary font-bold' : 'text-[#9ca3af] font-medium',
					]}
				>
					{link.label}
				</span>
			</a>
		))
	}
</nav>
