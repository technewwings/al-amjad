		alt: 'Delhi Monument',
		src: 'https://lh3.googleusercontent.com/aida-public/AB6AXuCwOm3lM_iK43BeUhFy3KkKNa2oRULZIsatCSHm-Hl6nZIJSepZ6viEDGPEOORFjKSluaF5MntWlOExyOPoRTB1ZHheL06st5Mplr-3htuRPWK9oqOcdrvFLnjTMADg1oAxbBS7h3-VltN5cKAmOnoDjnDmrQ3UahllDRgcXInKnW5Qi7VRVATkzTldT38OLshnSVyt3DELiTY3SF_a-ghX6kcJ3c5XtbVOUbh9inFsbsd_j25P',
