---

<section class="hero-section">
	<div class="hero-bg" aria-hidden="true">
		<img
			alt=""
			src="https://lh3.googleusercontent.com/aida-public/AB6AXuC3o2JqVvDxhvlAyWcFbadmy24vZmPYTvF7zCPNCbdF3aaVfCWwNs5GYrePUC-ZuJqBdAvoy2qWdwQcvrA7qtzNzLzQDYgiAg6WSm7kCX7nx_X3t9q0VeSOywVqBfTY5FZ4JCZz2BoBtRypVC4ZvNTIatwyRZDzTQBQXEPdmhoqAepFBTf6ugT6pbU_l2JmudKiXn7cTx6uZvFrIRNjvzXPLhZGR7ZZRIctDOy8kQKe8yC46lRh"
		/>
		<div class="hero-bg-fade"></div>
	</div>

	<div class="hero-inner">
		<div class="hero-copy">
			<p class="hero-eyebrow">It's Time To</p>
			<h1 class="hero-title">
				Explore The<br />
				<span>World</span> With Us
			</h1>
			<p class="hero-subtitle">Your Journey, Our Priority</p>

			<div class="hero-links">
				<a href="/destinations?tab=domestic"><span class="material-symbols-outlined">location_on</span> Domestic Tours</a>
				<span class="sep">|</span>
				<a href="/destinations?tab=international"><span class="material-symbols-outlined">public</span> International Tours</a>
				<span class="sep">|</span>
				<a href="/about"><span class="material-symbols-outlined">train</span> Bus &amp; Train Tickets</a>
			</div>
		</div>

		<div class="hero-ticket">
			<div class="ticket-frame">
				<div class="ticket-grid">
					{ticketImages.map((image) => <img alt={image.alt} src={image.src} loading="eager" />)}
				</div>
				<div class="ticket-holes ticket-holes-left">
					{Array.from({ length: 5 }).map(() => <i />)}
				</div>
				<div class="ticket-holes ticket-holes-right">
					{Array.from({ length: 5 }).map(() => <i />)}
				</div>
			</div>
		</div>

		<div class="trip-card">
			<div class="trip-card-head">
				<h2>Plan Your Trip</h2>
				<span class="material-symbols-outlined trip-plane">flight_takeoff</span>
			</div>

			<h3 class="trip-subhead">Choose a Service</h3>

			<div class="trip-tabs" role="tablist" aria-label="Trip type">
				<button type="button" class="tab tab-active" data-tour-type="domestic" role="tab" aria-selected="true">Domestic</button>
				<button type="button" class="tab" data-tour-type="international" role="tab" aria-selected="false">International</button>
				<button type="button" class="tab" data-tour-type="flight" role="tab" aria-selected="false">Flight</button>
				<button type="button" class="tab" data-tour-type="train" role="tab" aria-selected="false">Train</button>
			</div>

			<form id="trip-enquiry" class="trip-form">
				<input type="hidden" name="tourType" id="tour-type" value="Domestic Tours" />
				<label class="trip-field">
					<span id="destination-label">Where do you want to go?</span>
					<span class="trip-control">
						<input id="destination-input" name="destination" type="text" placeholder="e.g. Kashmir, Manali, Lakshadweep" required />
						<span id="destination-icon" class="material-symbols-outlined">location_on</span>
					</span>
				</label>

				<div class="trip-row">
					<label class="trip-field">
						<span>Travel Date</span>
						<span class="trip-control">
							<input name="travelDate" type="date" />
							<span class="material-symbols-outlined">calendar_month</span>
						</span>
					</label>
					<label class="trip-field">
						<span>Travellers</span>
						<span class="trip-control">
							<select name="travellers">
								<option value="1 Traveller">1 Traveller</option>
								<option value="2 Travellers">2 Travellers</option>
								<option value="3+ Travellers">3+ Travellers</option>
							</select>
							<span class="material-symbols-outlined">expand_more</span>
						</span>
					</label>
				</div>

				<button type="submit" class="trip-submit">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
					</svg>
					ENQUIRE NOW ON WHATSAPP
				</button>
			</form>
		</div>
	</div>
</section>

<style>
	.hero-section {
		position: relative;
		width: 100%;
		padding: 32px 16px 48px;
		overflow-x: clip;
		box-sizing: border-box;
	}

	@media (min-width: 768px) {
		.hero-section {
			padding: 56px 32px 72px;
		}
	}

	@media (min-width: 1024px) {
		.hero-section {
			min-height: 800px;
			padding: 80px 64px;
		}
	}

	.hero-bg {
		position: absolute;
		inset: 0;
		z-index: 0;
		overflow: hidden;
	}

	.hero-bg img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		opacity: 0.8;
	}

	.hero-bg-fade {
		position: absolute;
		inset: 0;
		background: linear-gradient(to bottom right, rgba(255, 255, 255, 0.95), rgba(255, 255, 255, 0.8), transparent);
	}

	.hero-inner {
		position: relative;
		z-index: 10;
		width: 100%;
		max-width: 80rem;
		margin: 0 auto;
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 24px;
	}

	@media (min-width: 1024px) {
		.hero-inner {
			grid-template-columns: minmax(0, 1fr) minmax(280px, 42%);
			align-items: start;
			gap: 48px;
		}

		.hero-copy {
			grid-column: 1;
			grid-row: 1;
		}

		.trip-card {
			grid-column: 1;
			grid-row: 2;
		}

		.hero-ticket {
			grid-column: 2;
			grid-row: 1 / span 2;
		}
	}

	.hero-copy {
		width: 100%;
		max-width: 42rem;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	.hero-eyebrow {
		margin: 0;
		font-family: "Plus Jakarta Sans", sans-serif;
		font-size: clamp(1.5rem, 4vw, 3rem);
		line-height: 1.15;
		font-style: italic;
		font-weight: 500;
		color: #5855a3;
	}

	.hero-title {
		margin: 0;
		font-family: "Plus Jakarta Sans", sans-serif;
		font-size: clamp(2.25rem, 6vw, 4.5rem);
		line-height: 1.05;
		font-weight: 800;
		color: #5855a3;
	}

	.hero-title span {
		color: #ba0013;
	}

	.hero-subtitle {
		margin: 0;
		font-family: "Plus Jakarta Sans", sans-serif;
		font-size: clamp(1.125rem, 2.5vw, 1.5rem);
		font-weight: 700;
		color: #191c1d;
	}

	.hero-links {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px 12px;
		font-family: "Work Sans", sans-serif;
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: #191c1d;
	}

	.hero-links a {
		color: inherit;
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.hero-links a:hover {
		color: #ba0013;
	}

	.hero-links .material-symbols-outlined {
		font-size: 16px;
		color: #ba0013;
		vertical-align: middle;
		margin-right: 4px;
	}

	.hero-links .sep {
		color: #926f6b;
	}

	@media (max-width: 479px) {
		.hero-links .sep {
			display: none;
		}
	}

	.trip-card {
		width: 100%;
		max-width: 32rem;
		margin-top: 0;
		background: #ffffff;
		border-radius: 24px;
		box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
		padding: 20px;
		box-sizing: border-box;
		min-width: 0;
	}

	@media (min-width: 640px) {
		.trip-card {
			padding: 32px;
		}
	}

	.trip-card-head {
		display: flex;
		align-items: center;
		gap: 8px;
		margin-bottom: 24px;
	}

	.trip-card-head h2 {
		margin: 0;
		font-family: "Plus Jakarta Sans", sans-serif;
		font-size: 1.5rem;
		font-weight: 700;
		color: #5855a3;
	}

	.trip-plane {
		color: #ba0013;
		font-size: 28px;
	}

	.trip-subhead {
		margin: 0 0 12px;
		font-family: "Work Sans", sans-serif;
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: #191c1d;
	}

	.trip-tabs {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-bottom: 24px;
	}

	.tab {
		flex: 1 1 calc(50% - 8px);
		border: 0;
		border-radius: 6px;
		padding: 8px 12px;
		min-height: 40px;
		font-family: "Work Sans", sans-serif;
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		cursor: pointer;
		background: #edeeef;
		color: #5d3f3c;
	}

	@media (min-width: 640px) {
		.tab {
			flex: 1 1 0;
		}
	}

	.tab-active {
		background: #ba0013;
		color: #ffffff;
	}

	.trip-form {
		display: flex;
		flex-direction: column;
		gap: 16px;
		width: 100%;
	}

	.trip-row {
		display: grid;
		grid-template-columns: 1fr;
		gap: 12px;
		width: 100%;
	}

	@media (min-width: 640px) {
		.trip-row {
			grid-template-columns: 1fr 1fr;
		}
	}

	.trip-field {
		display: flex;
		flex-direction: column;
		gap: 4px;
		width: 100%;
		min-width: 0;
	}

	.trip-field > span:first-child {
		font-family: "Work Sans", sans-serif;
		font-size: 12px;
		font-weight: 600;
		color: #191c1d;
	}

	.trip-control {
		position: relative;
		display: block;
		width: 100%;
		min-width: 0;
	}

	.trip-control input,
	.trip-control select {
		display: block;
		box-sizing: border-box;
		width: 100%;
		max-width: 100%;
		min-width: 0;
		height: 48px;
		padding: 12px 44px 12px 12px;
		border: 1px solid #e7bdb8;
		border-radius: 8px;
		background: #ffffff;
		color: #191c1d;
		font-family: "Be Vietnam Pro", sans-serif;
		font-size: 16px;
		line-height: 24px;
		outline: none;
		appearance: none;
		-webkit-appearance: none;
	}

	.trip-control input[type='date'] {
		-webkit-appearance: none;
	}

	.trip-control input:focus,
	.trip-control select:focus {
		border-color: #ba0013;
		box-shadow: 0 0 0 1px #ba0013;
	}

	.trip-control .material-symbols-outlined {
		position: absolute;
		right: 12px;
		top: 50%;
		transform: translateY(-50%);
		font-size: 20px;
		color: #5d3f3c;
		pointer-events: none;
	}

	.trip-submit {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		width: 100%;
		min-height: 48px;
		padding: 12px;
		border: 0;
		border-radius: 8px;
		background: #ba0013;
		color: #ffffff;
		font-family: "Work Sans", sans-serif;
		font-size: clamp(12px, 3.2vw, 14px);
		font-weight: 700;
		letter-spacing: 0.04em;
		text-align: center;
		cursor: pointer;
		box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
	}

	.trip-submit:hover {
		background: #e31e24;
	}

	.trip-submit svg {
		width: 20px;
		height: 20px;
		flex-shrink: 0;
	}

	.hero-ticket {
		flex: 0 0 auto;
		width: 100%;
		max-width: 28rem;
		margin: 0 auto;
		padding: 0;
		box-sizing: border-box;
		min-width: 0;
		animation: ticket-float 4.5s ease-in-out infinite;
	}

	@media (min-width: 1024px) {
		.hero-ticket {
			width: 100%;
			max-width: 32rem;
			margin: 48px 0 0 auto;
			padding: 0 8px;
		}
	}

	@keyframes ticket-float {
		0%,
		100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(-14px);
		}
	}

	.ticket-frame {
		position: relative;
		background: #ffffff;
		padding: 8px;
		border-radius: 8px;
		box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
		transform: rotate(0deg);
		transition: box-shadow 0.4s ease;
		animation: ticket-shadow 4.5s ease-in-out infinite;
	}

	@keyframes ticket-shadow {
		0%,
		100% {
			box-shadow: 0 20px 40px -12px rgba(0, 0, 0, 0.22);
		}
		50% {
			box-shadow: 0 32px 56px -12px rgba(0, 0, 0, 0.28);
		}
	}

	@media (min-width: 640px) {
		.ticket-frame {
			transform: rotate(-2deg);
		}
	}

	@media (min-width: 1024px) {
		.ticket-frame {
			transform: rotate(-3deg);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-ticket,
		.ticket-frame {
			animation: none;
		}
	}

	.ticket-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		grid-template-rows: repeat(2, minmax(0, 1fr));
		gap: 4px;
		height: 240px;
		overflow: hidden;
		border-radius: 6px;
		background: #edeeef;
	}

	@media (min-width: 640px) {
		.ticket-grid {
			grid-template-columns: repeat(4, minmax(0, 1fr));
			grid-template-rows: minmax(0, 1fr);
			height: 280px;
		}
	}

	@media (min-width: 1024px) {
		.ticket-grid {
			height: 340px;
		}
	}

	.ticket-grid img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		min-width: 0;
		min-height: 0;
	}

	.ticket-holes {
		position: absolute;
		top: 0;
		bottom: 0;
		width: 20px;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		padding: 20px 0;
		pointer-events: none;
		z-index: 2;
	}

	.ticket-holes-left {
		left: 0;
		transform: translateX(-50%);
	}

	.ticket-holes-right {
		right: 0;
		transform: translateX(50%);
	}

	.ticket-holes i {
		display: block;
		width: 14px;
		height: 14px;
		border-radius: 9999px;
		background: #e1e3e4;
		box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.15), 0 0 0 2px #ffffff;
	}
</style>

<script>
	const form = document.getElementById('trip-enquiry') as HTMLFormElement | null;
	const tourTypeInput = document.getElementById('tour-type') as HTMLInputElement | null;
	const destinationInput = document.getElementById('destination-input') as HTMLInputElement | null;
	const destinationLabel = document.getElementById('destination-label');
	const destinationIcon = document.getElementById('destination-icon');
	const tabs = document.querySelectorAll<HTMLButtonElement>('.trip-tabs .tab');

	const tabConfig: Record<string, { label: string; placeholder: string; fieldLabel: string; icon: string }> = {
		domestic: {
			label: 'Domestic Tours',
			placeholder: 'e.g. Kashmir, Manali, Lakshadweep',
			fieldLabel: 'Where do you want to go?',
			icon: 'location_on',
		},
		international: {
			label: 'International Tours',
			placeholder: 'e.g. Malaysia, Thailand, Jordan',
			fieldLabel: 'Where do you want to go?',
			icon: 'public',
		},
		flight: {
			label: 'Flight',
			placeholder: 'e.g. Kozhikode to Delhi',
			fieldLabel: 'Flight route',
			icon: 'flight_takeoff',
		},
		train: {
			label: 'Train',
			placeholder: 'e.g. Kasaragod to Chennai',
			fieldLabel: 'Train route',
			icon: 'train',
		},
	};

	tabs.forEach((tab) => {
		tab.addEventListener('click', () => {
			const type = tab.dataset.tourType || 'domestic';
			const config = tabConfig[type] ?? tabConfig.domestic;

			tabs.forEach((button) => {
				const active = button === tab;
				button.classList.toggle('tab-active', active);
				button.setAttribute('aria-selected', String(active));
			});

			if (tourTypeInput) tourTypeInput.value = config.label;
			if (destinationInput) destinationInput.placeholder = config.placeholder;
			if (destinationLabel) destinationLabel.textContent = config.fieldLabel;
			if (destinationIcon) destinationIcon.textContent = config.icon;
		});
	});

	form?.addEventListener('submit', (event) => {
		event.preventDefault();
		const data = new FormData(form);
		const tourType = String(data.get('tourType') || 'Domestic Tours').trim();
		const destination = String(data.get('destination') || '').trim();
		const travelDate = String(data.get('travelDate') || '').trim();
		const travellers = String(data.get('travellers') || '').trim();
		const message = [
			'Hello Al Amjad Tours & Travels!',
			`Enquiry type: ${tourType}`,
			tourType === 'Flight' || tourType === 'Train'
				? `I would like to enquire about a ${tourType.toLowerCase()} for: ${destination || 'N/A'}`
				: `I would like to enquire about a trip to: ${destination || 'N/A'}`,
			`Travel date: ${travelDate || 'Flexible'}`,
			`Travellers: ${travellers || 'N/A'}`,
		].join('\n');
		window.open(`https://wa.me/919995794058?text=${encodeURIComponent(message)}`, '_blank', 'noopener,noreferrer');
	});
</script>
