---
const packages = [
	{
		icon: 'family_restroom',
		title: 'Family Packages',
		description:
			'Create unforgettable memories with packages designed for all ages, prioritizing comfort and fun.',
		cta: 'Enquire Family Package',
		href: 'https://wa.me/919995794058?text=Hi%2C%20I%20am%20interested%20in%20family%20travel%20packages.',
	},
	{
		icon: 'groups',
		title: 'Group Packages',
		description:
			'Explore the world together with special rates and tailored itineraries for large groups and organizations.',
		cta: 'Enquire Group Package',
		href: 'https://wa.me/919995794058?text=Hi%2C%20I%20am%20interested%20in%20international%20group%20tours.',
	},
];
---

<section class="page-section py-12 md:py-20 bg-surface">
	<div class="page-container flex flex-col lg:flex-row gap-8 lg:gap-12 items-stretch lg:items-center min-w-0">
		<div class="w-full lg:w-1/2 flex flex-col gap-6 min-w-0">
			<div>
				<h2 class="text-2xl md:text-3xl font-bold text-primary" style="font-family: 'Plus Jakarta Sans', sans-serif;">
					Specialized Packages
				</h2>
				<p class="text-base md:text-lg text-on-surface-variant mt-3">
					Tailored experiences for every type of traveler. Choose from our expertly crafted Family and Group packages.
				</p>
			</div>
			<div class="flex flex-col gap-4">
				{
					packages.map((item) => (
						<div class="bg-surface-container-low p-4 md:p-6 rounded-xl border border-surface-variant flex flex-col sm:flex-row sm:items-start gap-4">
							<div class="bg-secondary-container text-on-secondary-container p-3 rounded-full shrink-0 self-start">
								<span class="material-symbols-outlined">{item.icon}</span>
							</div>
							<div class="min-w-0 flex-grow flex flex-col gap-3">
								<div>
									<h3 class="text-lg md:text-xl font-semibold text-on-surface">{item.title}</h3>
									<p class="text-sm md:text-base text-on-surface-variant mt-2">{item.description}</p>
								</div>
								<a
									href={item.href}
									target="_blank"
									rel="noopener noreferrer"
									class="self-start inline-flex items-center gap-2 text-sm font-semibold text-secondary hover:text-primary transition-colors"
								>
									{item.cta}
									<span class="material-symbols-outlined text-[18px]">arrow_forward</span>
								</a>
							</div>
						</div>
					))
				}
			</div>
		</div>
		<div class="w-full lg:w-1/2 min-w-0">
			<div class="relative rounded-2xl overflow-hidden shadow-lg h-56 sm:h-72 md:h-96 lg:h-[400px]">
				<img
					alt="Happy family on vacation"
					class="w-full h-full object-cover"
					src="https://lh3.googleusercontent.com/aida-public/AB6AXuDM0KYyPjH4Cf-sYT_kRX0PhEbDmEhbpzT3Ooq_jjiHC9k2uFR-76pmTgFmkhvikSbgzyo5cV_QBqepLXZM-EK5rKj4Sugb9AQ8FGD-SmCQITFRcOW0tNrGehFaCgoaJ032wX0GQ2-zf-B_p0JfnOIxnY9clEILoSRS7UfqE5UzO6z_sdABNuUaCtftcjmIfwA_md0pybsPkktFVzYxx6H42-MFFpiDeESGW1s8m7L4g4zVSumW"
					loading="lazy"
				/>
			</div>
		</div>
	</div>
</section>
