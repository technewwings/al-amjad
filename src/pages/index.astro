---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import TrustBanner from '../components/TrustBanner.astro';
import Destinations from '../components/Destinations.astro';
import SpecializedPackages from '../components/SpecializedPackages.astro';
import Services from '../components/Services.astro';
import Reviews from '../components/Reviews.astro';
import Cta from '../components/Cta.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
---

<Layout title="Home - Animated Transparent Flight - Al Amjad Tours & Travels">
	<Header />
	<main class="flex-grow flex flex-col">
		<Hero />
		<TrustBanner />
		<Destinations />
		<SpecializedPackages />
		<Services />
		<Reviews />
		<Cta />
	</main>
	<Footer />
	<WhatsAppFloat />
</Layout>
