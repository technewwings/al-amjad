---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import WhatsAppFloat from '../../components/WhatsAppFloat.astro';
import { destinationDetails, getDestinationBySlug } from '../../data/destinations';

export function getStaticPaths() {
	return destinationDetails.map((destination) => ({
		params: { slug: destination.slug },
	}));
}

const { slug } = Astro.params;
const destination = getDestinationBySlug(slug ?? '');

if (!destination) {
	throw new Error(`Unknown destination: ${slug}`);
}

const whatsappHref = `https://wa.me/919995794058?text=${encodeURIComponent(destination.whatsappMessage)}`;
const featuredImage = destination.gallery.find((image) => image.featured) ?? destination.gallery[0];
const sideImages = destination.gallery.filter((image) => image !== featuredImage);
---

<Layout title={`${destination.name} - Al Amjad Tours & Travels`}>
	<Header />
	<main class="flex-grow w-full min-w-0">
		<section class="relative h-[380px] sm:h-[460px] md:h-[560px] lg:h-[640px] w-full overflow-hidden">
			<div class="absolute inset-0 z-0">
				<img class="w-full h-full object-cover" alt={destination.hero.alt} src={destination.hero.src} />
				<div class="absolute inset-0 bg-gradient-to-t from-background via-transparent to-black/30"></div>
			</div>
			<div class="absolute inset-0 z-10 page-section page-container flex flex-col justify-end pb-8 md:pb-12">
				<div class="flex flex-wrap items-center gap-2 mb-3">
					{
						destination.badge && (
							<span class="bg-tertiary-container text-on-tertiary-container px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider inline-flex items-center gap-1">
								<span class="material-symbols-outlined filled text-[16px]">local_fire_department</span>
								{destination.badge}
							</span>
						)
					}
					<span class="bg-surface/80 backdrop-blur-sm text-on-surface px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider">
						{destination.country}
					</span>
				</div>
				<h1
					class="text-[28px] leading-9 sm:text-4xl md:text-5xl font-extrabold text-on-primary drop-shadow-md mb-3 break-words max-w-4xl"
					style="font-family: 'Plus Jakarta Sans', sans-serif;"
				>
					{destination.title}
				</h1>
				<p class="text-sm sm:text-base md:text-lg text-on-primary/90 max-w-2xl drop-shadow">
					{destination.tagline}
				</p>
				<div class="mt-3 inline-flex items-center gap-2 bg-surface/70 backdrop-blur-sm text-on-surface px-3 py-1.5 rounded-full w-fit shadow-sm">
					<span class="material-symbols-outlined text-[18px]">schedule</span>
					<span class="text-sm font-semibold">{destination.duration}</span>
				</div>
			</div>
			<a
				href="/destinations"
				class="absolute top-4 left-4 sm:top-6 sm:left-6 z-20 bg-surface/80 backdrop-blur-md text-on-surface hover:text-primary p-2 rounded-full shadow-sm transition-colors duration-200"
				aria-label="Back to destinations"
			>
				<span class="material-symbols-outlined">arrow_back</span>
			</a>
		</section>

		<div class="page-section page-container py-8 md:py-12 grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 min-w-0">
			<div class="lg:col-span-8 flex flex-col gap-10 md:gap-14 min-w-0">
				<section>
					<h2 class="text-2xl md:text-3xl font-bold text-on-surface mb-4" style="font-family: 'Plus Jakarta Sans', sans-serif;">
						Overview
					</h2>
					<div class="space-y-4">
						{
							destination.overview.split('\n\n').map((paragraph) => (
								<p class="text-base text-on-surface-variant leading-relaxed">{paragraph}</p>
							))
						}
					</div>
				</section>

				{
					destination.experiences.length > 0 && (
						<section>
							<h2 class="text-2xl md:text-3xl font-bold text-on-surface mb-2" style="font-family: 'Plus Jakarta Sans', sans-serif;">
								Places & visual experience
							</h2>
							<p class="text-base text-on-surface-variant mb-6">
								What you will see, feel, and taste in {destination.name}.
							</p>
							<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
								{destination.experiences.map((place) => (
									<article class="bg-surface-container-lowest rounded-xl overflow-hidden border border-surface-variant/50 shadow-[0px_4px_20px_rgba(27,20,100,0.08)]">
										<div class="aspect-[16/10] overflow-hidden bg-surface-container-high">
											<img class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" src={place.src} alt={place.alt} loading="lazy" />
										</div>
										<div class="p-4 md:p-5">
											{place.mood && (
												<span class="text-xs font-semibold uppercase tracking-wider text-secondary">{place.mood}</span>
											)}
											<h3 class="text-lg font-semibold text-on-surface mt-1" style="font-family: 'Plus Jakarta Sans', sans-serif;">
												{place.title}
											</h3>
											<p class="text-sm md:text-base text-on-surface-variant mt-2 leading-relaxed">{place.description}</p>
										</div>
									</article>
								))}
							</div>
						</section>
					)
				}

				{
					destination.itinerary.length > 0 && (
						<section>
							<h2 class="text-2xl md:text-3xl font-bold text-on-surface mb-4" style="font-family: 'Plus Jakarta Sans', sans-serif;">
								Itinerary
							</h2>
							<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
								{destination.itinerary.map((day) => (
									<div class="bg-surface-container-lowest rounded-xl p-4 md:p-6 shadow-[0px_4px_20px_rgba(27,20,100,0.08)] border border-surface-variant/50">
										<div class="flex items-center gap-3 mb-4 min-w-0">
											<span class="bg-primary-container text-on-primary-container w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold shrink-0">
												{day.day}
											</span>
											<h3 class="text-lg md:text-xl font-semibold text-on-surface min-w-0" style="font-family: 'Plus Jakarta Sans', sans-serif;">
												{day.title}
											</h3>
										</div>
										<ul class="space-y-4 relative before:absolute before:inset-y-2 before:left-[11px] before:w-0.5 before:bg-outline-variant/30">
											{day.stops.map((stop) => (
												<li class="relative pl-8">
													<span class="absolute left-0 top-1 w-6 h-6 rounded-full bg-surface-container flex items-center justify-center z-10 border-2 border-surface-container-lowest">
														<div class="w-2 h-2 rounded-full bg-secondary"></div>
													</span>
													<div class="text-xs font-semibold text-secondary mb-1">{stop.time}</div>
													<div class="font-semibold text-on-surface">{stop.title}</div>
													<p class="text-sm md:text-base text-on-surface-variant mt-1">{stop.description}</p>
												</li>
											))}
										</ul>
									</div>
								))}
							</div>
						</section>
					)
				}

				{
					sideImages.length > 0 && (
						<section>
							<h2 class="text-2xl md:text-3xl font-bold text-on-surface mb-4" style="font-family: 'Plus Jakarta Sans', sans-serif;">
								Visual Journey
							</h2>
							<div class="grid grid-cols-2 md:grid-cols-3 gap-2 sm:gap-3">
								{featuredImage && (
									<div class="col-span-2 rounded-xl overflow-hidden shadow-sm min-h-[180px] sm:min-h-[240px] md:min-h-[320px]">
										<img
											class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
											alt={featuredImage.alt}
											src={featuredImage.src}
										/>
									</div>
								)}
								{sideImages.map((image) => (
									<div class="rounded-xl overflow-hidden shadow-sm aspect-square">
										<img
											class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
											alt={image.alt}
											src={image.src}
											loading="lazy"
										/>
									</div>
								))}
							</div>
						</section>
					)
				}

				{
					destination.reviews.length > 0 && (
						<section>
							<h2 class="text-2xl md:text-3xl font-bold text-on-surface mb-2" style="font-family: 'Plus Jakarta Sans', sans-serif;">
								Traveler reviews
							</h2>
							<p class="text-base text-on-surface-variant mb-6">
								What guests say about this {destination.name} journey.
							</p>
							<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
								{destination.reviews.map((review) => (
									<article class="bg-surface p-5 md:p-6 rounded-xl shadow-md border border-surface-variant flex flex-col gap-3">
										<div class="flex items-center gap-3">
											{review.image ? (
												<div class="w-10 h-10 rounded-full overflow-hidden ring-2 ring-primary-fixed-dim shrink-0">
													<img alt="" class="w-full h-full object-cover" src={review.image} loading="lazy" />
												</div>
											) : (
												<div class="w-10 h-10 rounded-full bg-surface-container flex items-center justify-center shrink-0">
													<span class="material-symbols-outlined text-on-surface-variant">person</span>
												</div>
											)}
											<div class="flex text-tertiary-fixed gap-0.5">
												{Array.from({ length: 5 }).map((_, index) => (
													<span
														class:list={[
															'material-symbols-outlined text-[18px]',
															index < review.rating ? 'fill-current' : 'text-outline-variant',
														]}
													>
														star
													</span>
												))}
											</div>
										</div>
										<p class="text-sm md:text-base text-on-surface-variant italic leading-relaxed">"{review.quote}"</p>
										<h4 class="text-sm font-bold text-on-surface mt-auto pt-1">- {review.name}</h4>
									</article>
								))}
							</div>
						</section>
					)
				}
			</div>

			<div class="lg:col-span-4 min-w-0">
				<div class="lg:sticky lg:top-28 bg-surface-container-lowest rounded-xl p-5 md:p-6 shadow-[0px_8px_30px_rgba(27,20,100,0.12)] border border-surface-variant/50">
					<div class="flex justify-between items-start gap-3 mb-3">
						<div class="min-w-0">
							<span class="text-xs font-semibold text-on-surface-variant uppercase tracking-wider block mb-1">
								Pricing
							</span>
							<div class="text-lg md:text-xl font-semibold text-primary break-words" style="font-family: 'Plus Jakarta Sans', sans-serif;">
								Contact for Rates
							</div>
						</div>
						<div class="bg-secondary/10 text-secondary p-2 rounded-full shrink-0">
							<span class="material-symbols-outlined">verified</span>
						</div>
					</div>
					<p class="text-sm md:text-base text-on-surface-variant mb-4 pb-4 border-b border-surface-variant">
						{destination.duration}
					</p>
					<div class="space-y-3 mb-6">
						{
							destination.inclusions.map((item) => (
								<div class="flex items-center gap-3 min-w-0">
									<span class="material-symbols-outlined text-secondary shrink-0">{item.icon}</span>
									<span class="text-sm md:text-base text-on-surface">{item.label}</span>
								</div>
							))
						}
					</div>
					<a
						href={whatsappHref}
						target="_blank"
						rel="noopener noreferrer"
						class="w-full bg-primary hover:bg-primary-container text-on-primary text-sm font-semibold py-3.5 rounded-full transition-colors duration-200 flex justify-center items-center gap-2 shadow-md"
					>
						<svg class="w-5 h-5 shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
							<path
								d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L0 24l6.335-1.662c1.72.937 3.659 1.432 5.631 1.433h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
							></path>
						</svg>
						Chat on WhatsApp
					</a>
					<div class="mt-3 text-center">
						<a
							href="/contact"
							class="text-xs font-semibold text-secondary hover:text-on-secondary-fixed-variant transition-colors underline"
						>
							Need Help? Contact Support
						</a>
					</div>
				</div>
			</div>
		</div>
	</main>
	<Footer />
	<WhatsAppFloat />
</Layout>
